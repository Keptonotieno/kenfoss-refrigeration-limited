{
  "entities": {
    "users": {
      "title": "Users & Staff Profiles",
      "description": "User profiles, staff roles, and account security status",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "avatar": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "role": { "type": "string", "enum": ["Super Administrator", "Manager", "Technician", "Customer"] },
        "status": { "type": "string", "enum": ["Active", "Suspended", "Disabled"] },
        "twoFactorEnabled": { "type": "boolean" },
        "mustChangePassword": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "bookings": {
      "title": "Service Bookings",
      "description": "Service repair bookings and technician dispatch requests",
      "type": "object",
      "properties": {
        "bookingRef": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "location": { "type": "string" },
        "serviceType": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "assignedTechnicianId": { "type": "string" },
        "assignedTechnicianName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingRef", "email", "serviceType"]
    },
    "quotes": {
      "title": "Project Quotations",
      "description": "Commercial cold room and turnkey project estimates",
      "type": "object",
      "properties": {
        "rfqRef": { "type": "string" },
        "companyName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "projectType": { "type": "string" },
        "specs": { "type": "string" },
        "status": { "type": "string" },
        "quoteAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["rfqRef", "email", "projectType"]
    },
    "customers": {
      "title": "Customer CRM Records",
      "description": "Client directory and order history",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "location": { "type": "string" },
        "customerType": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "diagnostics": {
      "title": "AI HVAC Diagnostics",
      "description": "Saved AI HVAC & refrigeration diagnostic reports",
      "type": "object",
      "properties": {
        "applianceType": { "type": "string" },
        "brand": { "type": "string" },
        "symptoms": { "type": "string" },
        "diagnosisSummary": { "type": "string" },
        "severity": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["applianceType"]
    },
    "contacts": {
      "title": "Contact Inquiries",
      "description": "General customer inquiry messages",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    },
    "invitations": {
      "title": "Staff Invitations",
      "description": "Internal staff account single-use invitations",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdBy": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "email", "role"]
    },
    "auditLogs": {
      "title": "System Audit Logs",
      "description": "Security audit log stream for authentication and admin actions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "actorName": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "ipAddress": { "type": "string" }
      },
      "required": ["action", "actorName", "timestamp"]
    },
    "notifications": {
      "title": "System & Chat Notifications",
      "description": "Real-time system, chat, and activity alerts",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isRead": { "type": "boolean" },
        "link": { "type": "string" },
        "imageUrl": { "type": "string" },
        "imageName": { "type": "string" },
        "phone": { "type": "string" },
        "sender": { "type": "string" }
      },
      "required": ["title", "message", "createdAt"]
    },
    "technicians": {
      "title": "Technicians & Engineers",
      "description": "Technician and engineer profiles assigned to Kenya regional counties",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "specialty": { "type": "string" },
        "phone": { "type": "string" },
        "baseLocation": { "type": "string" },
        "rating": { "type": "number" },
        "experienceYears": { "type": "number" },
        "status": { "type": "string" },
        "counties": { "type": "array" }
      },
      "required": ["name", "phone", "role"]
    },
    "roles": {
      "title": "Role Definitions",
      "description": "Role definitions and permission rules for RBAC",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "permissions": { "type": "array" },
        "description": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  }
}
