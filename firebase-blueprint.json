{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles and account settings",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "bookings": {
      "title": "Bookings & Quotes",
      "description": "Service bookings and quotation requests",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "phone": { "type": "string" },
        "type": { "type": "string" },
        "serviceType": { "type": "string" },
        "equipmentDetails": { "type": "string" },
        "preferredDate": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "userEmail"]
    },
    "diagnostics": {
      "title": "AI Diagnostics",
      "description": "Saved AI HVAC & refrigeration diagnostic reports",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "equipmentType": { "type": "string" },
        "symptoms": { "type": "string" },
        "diagnosis": { "type": "string" },
