rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSystemInitOpen() {
      return !exists(/databases/$(database)/documents/settings/system_init) || 
             get(/databases/$(database)/documents/settings/system_init).data.setupCompleted != true;
    }

    function isSuperAdmin() {
      return isSystemInitOpen() || (
        isSignedIn() && userDocExists() && getUserData().role in [
          'Super Administrator', 'Super Admin', 'super_administrator', 'super_admin', 'superadmin',
          'Owner', 'owner', 'admin', 'Admin', 'Administrator', 'administrator'
        ]
      );
    }

    function isStaffOrAdmin() {
      return isSystemInitOpen() || (
        isSignedIn() && userDocExists() && getUserData().role in [
          'Super Administrator', 'Super Admin', 'super_administrator', 'super_admin', 'superadmin',
          'Owner', 'owner', 'admin', 'Admin', 'Administrator', 'administrator',
          'Manager', 'manager', 'Technician', 'technician', 'Staff', 'staff'
        ]
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isSystemInitOpen() || (isSignedIn() && (isOwner(userId) || isStaffOrAdmin()));
      allow create: if isSystemInitOpen() || (isSignedIn() && (isOwner(userId) || isStaffOrAdmin()));
      allow update: if isSystemInitOpen() || (isSignedIn() && (isOwner(userId) || isStaffOrAdmin()));
      allow delete: if isSuperAdmin();
    }

    // 2. Bookings
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if isStaffOrAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow delete: if isStaffOrAdmin();
    }

    // 3. Quotes / RFQs
    match /quotes/{quoteId} {
      allow read: if true;
      allow create: if true;
      allow update: if isStaffOrAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow delete: if isStaffOrAdmin();
    }

    // 4. Customers
    match /customers/{customerId} {
      allow read: if isStaffOrAdmin();
      allow create: if true;
      allow update: if isStaffOrAdmin();
      allow delete: if isSuperAdmin();
    }

    // 5. Diagnostics
    match /diagnostics/{diagnosticId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    // 6. Contact Messages
    match /contacts/{contactId} {
      allow read: if isStaffOrAdmin();
      allow create: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    // 7. Invitations
    match /invitations/{invitationId} {
      allow read: if true;
      allow create, update, delete: if isStaffOrAdmin();
    }

    // 8. Public CMS Collections
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // 9. Website & System Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSystemInitOpen() || isStaffOrAdmin();
    }

    // 10. Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    // 11. System Audit Logs
    match /auditLogs/{logId} {
      allow read: if isStaffOrAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // 12. Roles (RBAC)
    match /roles/{roleId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // 13. Technicians & Engineers
    match /technicians/{techId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
  }
}


