rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // HELPER FUNCTIONS & AUTHENTICATION VALIDATORS
    // ==========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Suspended or Disabled accounts are instantly stripped of data access
    function isActive() {
      return isSignedIn() &&
        request.auth.token.status != 'Suspended' &&
        request.auth.token.status != 'Disabled';
    }

    // Super Administrator verified via Firebase Auth custom claims
    function isSuperAdmin() {
      return isActive() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.accessLevel == 'super_admin' ||
        request.auth.token.role == 'Super Administrator'
      );
    }

    // Privileged Staff / Administrative roles
    function isStaffOrAdmin() {
      return isActive() && (
        isSuperAdmin() ||
        request.auth.token.role in [
          'super_admin', 'Super Administrator', 'manager', 'Manager',
          'technician', 'Technician', 'staff', 'Staff', 'admin', 'Admin'
        ] ||
        request.auth.token.accessLevel in ['super_admin', 'manager', 'technician', 'staff', 'admin']
      );
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================================
    // 1. SYSTEM INITIALIZATION CONFIGURATION (/system/config & /settings/system_init)
    // Client read allowed to verify initialization status; client writes strictly denied
    // ==========================================================
    match /system/config {
      allow read: if true;
      allow write: if false;
    }

    match /settings/system_init {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================================
    // 2. USER ACCOUNTS & PROFILES (/users/{userId})
    // Invariant 1: Privilege Isolation - no role escalation to SuperAdmin/Manager/Technician
    // Invariant 4: Non-admins can update profile info, but cannot alter role or status
    // Threat P1, P2, P8, P11, P12 mitigation
    // ==========================================================
    match /users/{userId} {
      // Reading user profiles requires ownership or staff access (prevents public scraping P8)
      allow read: if isOwner(userId) || isStaffOrAdmin();

      // Creation:
      // - SuperAdmin can provision any account
      // - Self-registration allows Customer role only (prevents P1, P11)
      allow create: if isSuperAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'Customer') &&
        (!('status' in request.resource.data) || request.resource.data.status == 'Active')
      );

      // Updates:
      // - SuperAdmin can update any field
      // - Users can update profile fields, but CANNOT change role, status, or mustChangePassword (prevents P2)
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) &&
        (!('mustChangePassword' in request.resource.data) || request.resource.data.mustChangePassword == resource.data.mustChangePassword)
      );

      // Deletion: SuperAdmin ONLY (prevents P12)
      allow delete: if isSuperAdmin();
    }

    // ==========================================================
    // 3. STAFF DIRECTORY (/staff/{userId})
    // Invariant 2: Privileged staff can ONLY be managed by active SuperAdmin
    // Threat P4 mitigation
    // ==========================================================
    match /staff/{userId} {
      allow read: if isStaffOrAdmin() || isOwner(userId);
      allow create, update, delete: if isSuperAdmin();
    }

    // ==========================================================
    // 4. SERVICE BOOKINGS (/bookings/{bookingId})
    // Threat P3 (Suspended staff) & P7 (Cross-customer boundary) mitigation
    // ==========================================================
    match /bookings/{bookingId} {
      allow read: if isStaffOrAdmin() || (
        isActive() && (
          resource.data.userId == request.auth.uid ||
          resource.data.email == request.auth.token.email
        )
      );
      allow create: if true;
      allow update: if isStaffOrAdmin() || (
        isActive() && (
          resource.data.userId == request.auth.uid ||
          resource.data.email == request.auth.token.email
        )
      );
      allow delete: if isStaffOrAdmin();
    }

    // ==========================================================
    // 5. COMMERCIAL QUOTATIONS / RFQs (/quotes/{quoteId})
    // ==========================================================
    match /quotes/{quoteId} {
      allow read: if isStaffOrAdmin() || (
        isActive() && (
          resource.data.userId == request.auth.uid ||
          resource.data.email == request.auth.token.email
        )
      );
      allow create: if true;
      allow update: if isStaffOrAdmin() || (
        isActive() && (
          resource.data.userId == request.auth.uid ||
          resource.data.email == request.auth.token.email
        )
      );
      allow delete: if isStaffOrAdmin();
    }

    // ==========================================================
    // 6. CUSTOMER CRM RECORDS (/customers/{customerId})
    // ==========================================================
    match /customers/{customerId} {
      allow read: if isStaffOrAdmin();
      allow create: if true;
      allow update: if isStaffOrAdmin();
      allow delete: if isSuperAdmin();
    }

    // ==========================================================
    // 7. AI HVAC DIAGNOSTICS (/diagnostics/{diagnosticId})
    // ==========================================================
    match /diagnostics/{diagnosticId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    // ==========================================================
    // 8. CONTACT INQUIRIES & MESSAGES (/contacts/{contactId})
    // ==========================================================
    match /contacts/{contactId} {
      allow read: if isStaffOrAdmin();
      allow create: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    // ==========================================================
    // 9. STAFF INVITATIONS (/invitations/{invitationId})
    // ==========================================================
    match /invitations/{invitationId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // ==========================================================
    // 10. IMMUTABLE SYSTEM AUDIT LOGS (/auditLogs/{logId})
    // Invariant 3: Append-only by authenticated users, NEVER modified or deleted
    // Threat P5, P6 mitigation
    // ==========================================================
    match /auditLogs/{logId} {
      allow read: if isStaffOrAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // IMMUTABLE: no client role can alter or delete
    }

    // ==========================================================
    // 11. WEBSITE & SYSTEM SETTINGS (/settings/{settingId})
    // Threat P10 mitigation: SuperAdmin ONLY for write
    // ==========================================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ==========================================================
    // 12. NOTIFICATIONS (/notifications/{notificationId})
    // ==========================================================
    match /notifications/{notificationId} {
      allow read: if isStaffOrAdmin() || (
        isActive() && (
          resource.data.recipientId == request.auth.uid ||
          resource.data.recipientEmail == request.auth.token.email
        )
      );
      allow create: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    // ==========================================================
    // 13. ROLES & PERMISSION MATRIX (/roles/{roleId})
    // ==========================================================
    match /roles/{roleId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ==========================================================
    // 14. FIELD TECHNICIANS & DISPATCH (/technicians/{techId})
    // ==========================================================
    match /technicians/{techId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // ==========================================================
    // 15. PUBLIC CMS CONTENT (Services, Projects, Testimonials, Blogs, Gallery)
    // ==========================================================
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
  }
}
