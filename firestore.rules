rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Authorization checks based on Firebase Auth Custom Claims (set by trusted Admin SDK server)
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.accessLevel == 'super_admin' ||
        request.auth.token.role == 'Super Administrator'
      );
    }

    function isStaffOrAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.token.role in [
          'super_admin', 'Super Administrator', 'manager', 'Manager',
          'technician', 'Technician', 'staff', 'Staff', 'admin', 'Admin'
        ] ||
        request.auth.token.accessLevel in ['super_admin', 'manager', 'technician', 'staff', 'admin']
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Authoritative System Initialization Record (/system/config)
    // Public/Client read allowed for setup status check, writes strictly forbidden to clients (handled by Admin SDK)
    match /system/config {
      allow read: if true;
      allow write: if false;
    }

    // 2. Staff Directory collection (/staff/{userId})
    match /staff/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isStaffOrAdmin());
      allow create, update: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // 3. User Accounts collection (/users/{userId})
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isStaffOrAdmin());
      allow create, update: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // 4. Bookings
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if isStaffOrAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow delete: if isStaffOrAdmin();
    }

    // 5. Quotes / Commercial RFQs
    match /quotes/{quoteId} {
      allow read: if true;
      allow create: if true;
      allow update: if isStaffOrAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow delete: if isStaffOrAdmin();
    }

    // 6. Customers CRM
    match /customers/{customerId} {
      allow read: if isStaffOrAdmin();
      allow create: if true;
      allow update: if isStaffOrAdmin();
      allow delete: if isSuperAdmin();
    }

    // 7. AI Diagnostics
    match /diagnostics/{diagnosticId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    // 8. Contact Messages
    match /contacts/{contactId} {
      allow read: if isStaffOrAdmin();
      allow create: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    // 9. Invitations
    match /invitations/{invitationId} {
      allow read: if true;
      allow create, update, delete: if isStaffOrAdmin();
    }

    // 10. Public CMS Collections
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // 11. Website & System Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 12. Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    // 13. System Audit Logs
    match /auditLogs/{logId} {
      allow read: if isStaffOrAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // 14. Roles (RBAC)
    match /roles/{roleId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 15. Technicians & Engineers
    match /technicians/{techId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
  }
}
