rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemInitCompleted() {
      return exists(/databases/$(database)/documents/settings/system_init) &&
        get(/databases/$(database)/documents/settings/system_init).data.setupCompleted == true;
    }

    function isAuthTokenAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['keptonromez62@gmail.com', 'keptonotieno@gmail.com'] ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*'))
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAccountActive() {
      return isSignedIn() && (
        !hasUserDoc() ||
        (getUserData().status != 'Suspended' && getUserData().status != 'Disabled')
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && isAccountActive() && (
        isAuthTokenAdmin() ||
        (hasUserDoc() && getUserData().role in ['Super Administrator', 'Owner', 'Admin', 'admin', 'Super Admin'])
      );
    }

    function isManager() {
      return isSuperAdmin() || (
        isSignedIn() && isAccountActive() && (
          hasUserDoc() && getUserData().role in ['Manager', 'manager', 'Manager / Supervisor', 'Manager/Supervisor']
        )
      );
    }

    function isTechnician() {
      return isManager() || (
        isSignedIn() && isAccountActive() && (
          hasUserDoc() && getUserData().role in ['Technician', 'technician', 'Senior Technician', 'Junior Technician']
        )
      );
    }

    function isStaff() {
      return isTechnician() || isAuthTokenAdmin();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if (isSignedIn() && request.auth.uid == userId) || isStaff();
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isSuperAdmin())) || isStaff();
      allow delete: if isSuperAdmin();
    }

    // 2. Bookings
    match /bookings/{bookingId} {
      allow create: if true;
      allow read: if isStaff() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.email));
      allow update: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // 3. Quotes / RFQs
    match /quotes/{quoteId} {
      allow create: if true;
      allow read: if isStaff() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.email));
      allow update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // 4. Customers
    match /customers/{customerId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // 5. Diagnostics
    match /diagnostics/{diagnosticId} {
      allow create: if true;
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isStaff();
    }

    // 6. Contact Messages
    match /contacts/{contactId} {
      allow create: if true;
      allow read: if isStaff();
      allow update, delete: if isStaff();
    }

    // 7. Single-use Admin Invitations
    match /invitations/{invitationId} {
      allow read: if true;
      allow create, update, delete: if isStaff() || (isSignedIn() && request.resource.data.status == 'Used');
    }

    // 8. CMS Collections (Services, Projects, Testimonials, Blogs, Gallery)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 9. Website & Contact Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 10. Notifications
    match /notifications/{notificationId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isStaff() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 11. System Audit Logs
    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow create: if isSignedIn() || isStaff();
      allow update, delete: if isSuperAdmin();
    }
  }
}
